# Copy to .env.local and fill in. See docs/IMPLEMENTATION_PLAN.md section 10.
# Nothing here is required to run `npm run dev` against a local MongoDB with the
# stub drivers — the app boots on defaults and logs what it would have sent.

# --- Database -----------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=herbedia

# --- Session secrets ----------------------------------------------------------
# Generate with: openssl rand -base64 32
# Customers and admins are signed with different keys on purpose: leaking one
# must not mint sessions for the other.
AUTH_CUSTOMER_SECRET=dev-only-customer-secret-change-me-please-32ch
AUTH_ADMIN_SECRET=dev-only-admin-secret-change-me-please-32chars

# --- Stripe -------------------------------------------------------------------
# Test keys until launch. STRIPE_WEBHOOK_SECRET comes from `stripe listen`
# locally, or from the endpoint you create in the dashboard in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email --------------------------------------------------------------------
# MAIL_DRIVER=console prints messages to the server log instead of sending.
MAIL_DRIVER=console
RESEND_API_KEY=
MAIL_FROM="Herbedia <orders@example.com>"

# --- File storage -------------------------------------------------------------
# STORAGE_DRIVER=stub keeps uploads in memory-backed fake URLs for local work.
# Set s3 and fill the rest for a real bucket (S3, Cloudflare R2, Backblaze B2).
STORAGE_DRIVER=stub
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Scheduled jobs -----------------------------------------------------------
# In-process node-cron. Keep false in development so a dev server does not email
# anyone; the jobs are also runnable by hand from the admin panel.
CRON_ENABLED=false
TZ=Asia/Dubai

# --- Seeding ------------------------------------------------------------------
# Used once by `npm run seed` to create the Owner admin account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
